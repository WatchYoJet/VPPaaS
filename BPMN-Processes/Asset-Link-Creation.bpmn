<?xml version="1.0" encoding="UTF-8"?>
<ns2:definitions xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <ns2:collaboration id="Collaboration_AssetLinkCreation">
    <ns2:participant id="Participant_Prosumer" name="Prosumer" processRef="AssetLinkCreation" />
    <ns2:participant id="Participant_AssetLink" name="VPPaaS - ASSETLINK" processRef="VPPaaSAssetLinkCreation" />
    <ns2:participant id="Participant_Telemetry" name="VPPaaS - TELEMETRY" processRef="VPPaaSAssetLinkTelemetry" />
    <!-- Prosumer ↔ AssetLink Messages -->
    <ns2:messageFlow id="MsgFlow_Request" sourceRef="Send_Request" targetRef="StartEvent_AssetLink" />
    <ns2:messageFlow id="MsgFlow_Promise" sourceRef="Send_Promise" targetRef="Catch_Promise" />
    <ns2:messageFlow id="MsgFlow_Decline" sourceRef="Send_Decline" targetRef="Catch_Decline" />
    <ns2:messageFlow id="MsgFlow_Declare" sourceRef="Send_Declare" targetRef="Catch_Declare" />
    <ns2:messageFlow id="MsgFlow_Accept" sourceRef="Send_Accept" targetRef="Catch_Accept" />
    <!-- AssetLink → Telemetry Messages -->
    <ns2:messageFlow id="MsgFlow_TelemetryActivate" sourceRef="Send_TelemetryActivation" targetRef="StartEvent_Telemetry" />
    <ns2:messageFlow id="MsgFlow_TelemetryConfirm" sourceRef="Send_TelemetryConfirm" targetRef="Catch_TelemetryConfirm" />
  </ns2:collaboration>

  <!-- ===== POOL 1: PROSUMER (Initiator) ===== -->
  <ns2:process id="AssetLinkCreation" name="AssetLinkCreation" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_Prosumer">
      <ns2:lane id="Lane_ProsumerInit" name="Initiator">
        <ns2:flowNodeRef>StartEvent_Prosumer</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_FillData</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Merge</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Request</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_WaitResult</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Promise</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Decline</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Declare</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_CheckLink</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Accept</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Success</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_DecideNext</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Retry</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_NoRetry</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_Prosumer">
      <ns2:outgoing>Flow_P1</ns2:outgoing>
    </ns2:startEvent>
    <ns2:userTask id="Task_FillData" name="Decide the Data for Asset Link Association order" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="ProsumerID" label="ProsumerID" type="string" />
          <camunda:formField id="AssetID" label="AssetID" type="string" />
          <camunda:formField id="AssetType" label="AssetType (BATTERY|SOLAR|EV_CHARGER)" type="string" />
          <camunda:formField id="UtilityOperatorID" label="UtilityOperatorID" type="string" />
          <camunda:formField id="GridCellID" label="GridCellID" type="string" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P1</ns2:incoming>
      <ns2:outgoing>Flow_P2</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Merge">
      <ns2:incoming>Flow_P2</ns2:incoming>
      <ns2:incoming>Flow_Retry_Yes</ns2:incoming>
      <ns2:outgoing>Flow_P3</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:sendTask id="Send_Request" name="Request Asset Link Association order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/process-definition/key/VPPaaSAssetLinkCreation/start</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
"businessKey":"${execution.processBusinessKey}",
"variables": {
"ProsumerID": {"value":"${ProsumerID}","type":"string"},
"AssetID": {"value":"${AssetID}","type":"string"},
"AssetType": {"value":"${AssetType}","type":"string"},
"UtilityOperatorID":{"value":"${UtilityOperatorID}","type":"string"},
"GridCellID":{"value":"${GridCellID}","type":"string"},
"businessKeyRequester":{"value":"${execution.processBusinessKey}","type":"string"}
} }</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P3</ns2:incoming>
      <ns2:outgoing>Flow_P4</ns2:outgoing>
    </ns2:sendTask>
    <ns2:eventBasedGateway id="Gateway_WaitResult" name="Wait for Request result">
      <ns2:incoming>Flow_P4</ns2:incoming>
      <ns2:outgoing>Flow_ToPromise</ns2:outgoing>
      <ns2:outgoing>Flow_ToDecline</ns2:outgoing>
    </ns2:eventBasedGateway>
    <ns2:intermediateCatchEvent id="Catch_Promise" name="Promise received">
      <ns2:incoming>Flow_ToPromise</ns2:incoming>
      <ns2:outgoing>Flow_P5</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Promise" messageRef="Message_ALPromise" />
    </ns2:intermediateCatchEvent>
    <ns2:intermediateCatchEvent id="Catch_Decline" name="Decline received">
      <ns2:incoming>Flow_ToDecline</ns2:incoming>
      <ns2:outgoing>Flow_P_Decline</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Decline" messageRef="Message_ALDecline" />
    </ns2:intermediateCatchEvent>
    <ns2:intermediateCatchEvent id="Catch_Declare" name="Declare received">
      <ns2:incoming>Flow_P5</ns2:incoming>
      <ns2:outgoing>Flow_P6</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Declare" messageRef="Message_ALDeclare" />
    </ns2:intermediateCatchEvent>
    <ns2:userTask id="Task_CheckLink" name="Check Asset Link Association order" camunda:assignee="demo">
      <ns2:documentation>Acknowledge the Asset Link creation and Kafka topic activation.</ns2:documentation>
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="assetLinkID" label="assetLinkID" type="string" defaultValue="${assetLinkID}" />
          <camunda:formField id="kafkaTopic" label="kafkaTopic" type="string" defaultValue="${kafkaTopic}" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P6</ns2:incoming>
      <ns2:outgoing>Flow_P7</ns2:outgoing>
    </ns2:userTask>
    <ns2:sendTask id="Send_Accept" name="Accept Asset Link Association order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
"messageName" : "Message_ALAccept",
"businessKey" : "${execution.processBusinessKey}",
"resultEnabled" : true
}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P7</ns2:incoming>
      <ns2:outgoing>Flow_P8</ns2:outgoing>
    </ns2:sendTask>
    <ns2:endEvent id="EndEvent_Success">
      <ns2:incoming>Flow_P8</ns2:incoming>
    </ns2:endEvent>
    <ns2:userTask id="Task_DecideNext" name="Decide what to do next" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="newrequest" label="newrequest" type="boolean" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P_Decline</ns2:incoming>
      <ns2:outgoing>Flow_P_Decision</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Retry" name="Make new request?">
      <ns2:incoming>Flow_P_Decision</ns2:incoming>
      <ns2:outgoing>Flow_Retry_Yes</ns2:outgoing>
      <ns2:outgoing>Flow_Retry_No</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:endEvent id="EndEvent_NoRetry">
      <ns2:incoming>Flow_Retry_No</ns2:incoming>
    </ns2:endEvent>
    <ns2:sequenceFlow id="Flow_P1" sourceRef="StartEvent_Prosumer" targetRef="Task_FillData" />
    <ns2:sequenceFlow id="Flow_P2" sourceRef="Task_FillData" targetRef="Gateway_Merge" />
    <ns2:sequenceFlow id="Flow_P3" sourceRef="Gateway_Merge" targetRef="Send_Request" />
    <ns2:sequenceFlow id="Flow_P4" sourceRef="Send_Request" targetRef="Gateway_WaitResult" />
    <ns2:sequenceFlow id="Flow_ToPromise" sourceRef="Gateway_WaitResult" targetRef="Catch_Promise" />
    <ns2:sequenceFlow id="Flow_ToDecline" sourceRef="Gateway_WaitResult" targetRef="Catch_Decline" />
    <ns2:sequenceFlow id="Flow_P5" sourceRef="Catch_Promise" targetRef="Catch_Declare" />
    <ns2:sequenceFlow id="Flow_P6" sourceRef="Catch_Declare" targetRef="Task_CheckLink" />
    <ns2:sequenceFlow id="Flow_P7" sourceRef="Task_CheckLink" targetRef="Send_Accept" />
    <ns2:sequenceFlow id="Flow_P8" sourceRef="Send_Accept" targetRef="EndEvent_Success" />
    <ns2:sequenceFlow id="Flow_P_Decline" sourceRef="Catch_Decline" targetRef="Task_DecideNext" />
    <ns2:sequenceFlow id="Flow_P_Decision" sourceRef="Task_DecideNext" targetRef="Gateway_Retry" />
    <ns2:sequenceFlow id="Flow_Retry_Yes" name="Yes" sourceRef="Gateway_Retry" targetRef="Gateway_Merge">
      <ns2:conditionExpression xsi:type="ns2:tFormalExpression">${newrequest}</ns2:conditionExpression>
    </ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_Retry_No" name="No" sourceRef="Gateway_Retry" targetRef="EndEvent_NoRetry">
      <ns2:conditionExpression xsi:type="ns2:tFormalExpression">${!newrequest}</ns2:conditionExpression>
    </ns2:sequenceFlow>
  </ns2:process>

  <!-- ===== POOL 2: VPPaaS - ASSETLINK (Executor) ===== -->
  <ns2:process id="VPPaaSAssetLinkCreation" name="VPPaaSAssetLinkCreation" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_AssetLink">
      <ns2:lane id="Lane_ALExecutor" name="Executor">
        <ns2:flowNodeRef>StartEvent_AssetLink</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_Verify</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Approve</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Promise</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_KongAddress</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_CreateAssetLink</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_TelemetryActivation</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_TelemetryConfirm</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Declare</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Accept</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Executor</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Decline</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Declined</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_AssetLink" name="Request received">
      <ns2:outgoing>Flow_V1</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Request" messageRef="Message_ALRequest" />
    </ns2:startEvent>
    <ns2:userTask id="Task_Verify" name="Verify if execute association is possible" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="promise" label="promise" type="boolean" defaultValue="true" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V1</ns2:incoming>
      <ns2:outgoing>Flow_V2</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Approve" name="ok to associate?">
      <ns2:incoming>Flow_V2</ns2:incoming>
      <ns2:outgoing>Flow_Approve_Yes</ns2:outgoing>
      <ns2:outgoing>Flow_Approve_No</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:sendTask id="Send_Promise" name="Promise Asset Link Association order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
"messageName" : "Message_ALPromise",
"businessKey" : "${businessKeyRequester}",
"resultEnabled" : true
}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_Approve_Yes</ns2:incoming>
      <ns2:outgoing>Flow_V3</ns2:outgoing>
    </ns2:sendTask>
    <ns2:scriptTask id="Task_KongAddress" name="Obtain Kong Address" scriptFormat="JavaScript">
      <ns2:incoming>Flow_V3</ns2:incoming>
      <ns2:outgoing>Flow_V4</ns2:outgoing>
      <ns2:script>execution.getProcessInstance().setVariable("KONG_ADDRESS", java.lang.System.getenv("KONG_ADDRESS"));</ns2:script>
    </ns2:scriptTask>
    <ns2:serviceTask id="Task_CreateAssetLink" name="Create Asset Link via Kong">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">{
  "prosumerID": "${ProsumerID}",
  "assetID": "${AssetID}",
  "assetType": "${AssetType}",
  "utilityOperatorID": "${UtilityOperatorID}",
  "gridCellID": "${GridCellID}"
}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/AssetLink</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="accept">application/json</camunda:entry>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="assetLinkID">
              <camunda:script scriptFormat="JavaScript">S(connector.getVariable("response")).jsonPath("id").stringValue();</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V4</ns2:incoming>
      <ns2:outgoing>Flow_V5</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:sendTask id="Send_TelemetryActivation" name="Activate Telemetry Ingestion for this Asset Link">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/process-definition/key/VPPaaSAssetLinkTelemetry/start</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
"businessKey":"${execution.processBusinessKey}",
"variables": {
"AssetLinkID": {"value":"${assetLinkID}","type":"string"},
"UtilityOperatorID": {"value":"${UtilityOperatorID}","type":"string"},
"KafkaTopic": {"value":"${assetLinkID}-${UtilityOperatorID}","type":"string"},
"businessKeyRequester":{"value":"${execution.processBusinessKey}","type":"string"}
} }</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V5</ns2:incoming>
      <ns2:outgoing>Flow_V6</ns2:outgoing>
    </ns2:sendTask>
    <ns2:intermediateCatchEvent id="Catch_TelemetryConfirm" name="Telemetry activated">
      <ns2:incoming>Flow_V6</ns2:incoming>
      <ns2:outgoing>Flow_V7</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_TelConfirm" messageRef="Message_TelemetryConfirm" />
    </ns2:intermediateCatchEvent>
    <ns2:sendTask id="Send_Declare" name="Declare Asset Link Association order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">{
"messageName" : "Message_ALDeclare",
"businessKey" : "${businessKeyRequester}",
"resultEnabled" : true,
"processVariables": {
    "assetLinkID": {"value": "${assetLinkID}", "type": "String"},
    "kafkaTopic": {"value": "${assetLinkID}-${UtilityOperatorID}", "type": "String"}
}
}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V7</ns2:incoming>
      <ns2:outgoing>Flow_V8</ns2:outgoing>
    </ns2:sendTask>
    <ns2:intermediateCatchEvent id="Catch_Accept" name="Accept received">
      <ns2:incoming>Flow_V8</ns2:incoming>
      <ns2:outgoing>Flow_V9</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Accept" messageRef="Message_ALAccept" />
    </ns2:intermediateCatchEvent>
    <ns2:endEvent id="EndEvent_Executor">
      <ns2:incoming>Flow_V9</ns2:incoming>
    </ns2:endEvent>
    <ns2:sendTask id="Send_Decline" name="Decline Asset Link Association order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">{
"messageName" : "Message_ALDecline",
"businessKey" : "${businessKeyRequester}",
"resultEnabled" : true
}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_Approve_No</ns2:incoming>
      <ns2:outgoing>Flow_V_Decline</ns2:outgoing>
    </ns2:sendTask>
    <ns2:endEvent id="EndEvent_Declined">
      <ns2:incoming>Flow_V_Decline</ns2:incoming>
    </ns2:endEvent>
    <ns2:sequenceFlow id="Flow_V1" sourceRef="StartEvent_AssetLink" targetRef="Task_Verify" />
    <ns2:sequenceFlow id="Flow_V2" sourceRef="Task_Verify" targetRef="Gateway_Approve" />
    <ns2:sequenceFlow id="Flow_Approve_Yes" name="Yes" sourceRef="Gateway_Approve" targetRef="Send_Promise">
      <ns2:conditionExpression xsi:type="ns2:tFormalExpression">${promise}</ns2:conditionExpression>
    </ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_Approve_No" name="No" sourceRef="Gateway_Approve" targetRef="Send_Decline">
      <ns2:conditionExpression xsi:type="ns2:tFormalExpression">${!promise}</ns2:conditionExpression>
    </ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_V3" sourceRef="Send_Promise" targetRef="Task_KongAddress" />
    <ns2:sequenceFlow id="Flow_V4" sourceRef="Task_KongAddress" targetRef="Task_CreateAssetLink" />
    <ns2:sequenceFlow id="Flow_V5" sourceRef="Task_CreateAssetLink" targetRef="Send_TelemetryActivation" />
    <ns2:sequenceFlow id="Flow_V6" sourceRef="Send_TelemetryActivation" targetRef="Catch_TelemetryConfirm" />
    <ns2:sequenceFlow id="Flow_V7" sourceRef="Catch_TelemetryConfirm" targetRef="Send_Declare" />
    <ns2:sequenceFlow id="Flow_V8" sourceRef="Send_Declare" targetRef="Catch_Accept" />
    <ns2:sequenceFlow id="Flow_V9" sourceRef="Catch_Accept" targetRef="EndEvent_Executor" />
    <ns2:sequenceFlow id="Flow_V_Decline" sourceRef="Send_Decline" targetRef="EndEvent_Declined" />
  </ns2:process>

  <!-- ===== POOL 3: VPPaaS - TELEMETRY ===== -->
  <ns2:process id="VPPaaSAssetLinkTelemetry" name="VPPaaSAssetLinkTelemetry" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_Telemetry">
      <ns2:lane id="Lane_TelExecutor" name="Executor">
        <ns2:flowNodeRef>StartEvent_Telemetry</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_TelKongAddress</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_CreateKafkaTopic</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_TelemetryConfirm</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Telemetry</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_Telemetry" name="Activation received">
      <ns2:outgoing>Flow_T1</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_TelActivate" messageRef="Message_TelemetryActivate" />
    </ns2:startEvent>
    <ns2:scriptTask id="Task_TelKongAddress" name="Obtain Kong Address" scriptFormat="JavaScript">
      <ns2:incoming>Flow_T1</ns2:incoming>
      <ns2:outgoing>Flow_T2</ns2:outgoing>
      <ns2:script>execution.getProcessInstance().setVariable("KONG_ADDRESS", java.lang.System.getenv("KONG_ADDRESS"));</ns2:script>
    </ns2:scriptTask>
    <ns2:serviceTask id="Task_CreateKafkaTopic" name="Create Kafka Topic (AssetLinkID-UtilityOperator)">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/telemetry/create-topic</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
  "topicName": "${KafkaTopic}",
  "assetLinkID": "${AssetLinkID}",
  "utilityOperatorID": "${UtilityOperatorID}"
}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_T2</ns2:incoming>
      <ns2:outgoing>Flow_T3</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:sendTask id="Send_TelemetryConfirm" name="Confirm Telemetry Activation">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{
"messageName" : "Message_TelemetryConfirm",
"businessKey" : "${businessKeyRequester}",
"resultEnabled" : true
}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_T3</ns2:incoming>
      <ns2:outgoing>Flow_T4</ns2:outgoing>
    </ns2:sendTask>
    <ns2:endEvent id="EndEvent_Telemetry">
      <ns2:incoming>Flow_T4</ns2:incoming>
    </ns2:endEvent>
    <ns2:sequenceFlow id="Flow_T1" sourceRef="StartEvent_Telemetry" targetRef="Task_TelKongAddress" />
    <ns2:sequenceFlow id="Flow_T2" sourceRef="Task_TelKongAddress" targetRef="Task_CreateKafkaTopic" />
    <ns2:sequenceFlow id="Flow_T3" sourceRef="Task_CreateKafkaTopic" targetRef="Send_TelemetryConfirm" />
    <ns2:sequenceFlow id="Flow_T4" sourceRef="Send_TelemetryConfirm" targetRef="EndEvent_Telemetry" />
  </ns2:process>

  <!-- ===== MESSAGES ===== -->
  <ns2:message id="Message_ALRequest" name="Message_ALRequest" />
  <ns2:message id="Message_ALPromise" name="Message_ALPromise" />
  <ns2:message id="Message_ALDecline" name="Message_ALDecline" />
  <ns2:message id="Message_ALDeclare" name="Message_ALDeclare" />
  <ns2:message id="Message_ALAccept" name="Message_ALAccept" />
  <ns2:message id="Message_TelemetryActivate" name="Message_TelemetryActivate" />
  <ns2:message id="Message_TelemetryConfirm" name="Message_TelemetryConfirm" />

