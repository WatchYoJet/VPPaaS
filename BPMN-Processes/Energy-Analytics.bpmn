<?xml version="1.0" encoding="UTF-8"?>
<ns2:definitions xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <ns2:collaboration id="Collaboration_EnergyAnalytics">
    <ns2:participant id="Participant_VPPaaS" name="VPPaaS" processRef="EnergyAnalytics" />
  </ns2:collaboration>
  <ns2:process id="EnergyAnalytics" name="EnergyAnalytics" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_EA">
      <ns2:lane id="Lane_Executor" name="Executor">
        <ns2:flowNodeRef>StartEvent_1</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_KongAddress</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_ComputeDischargedByZone</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_ComputeGeneratedByProsumer</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_ComputeConsumedByProsumer</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_ComputeAverageSoC</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_PublishKafka</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Done</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_1" name="End of Day">
      <ns2:outgoing>Flow_1</ns2:outgoing>
    </ns2:startEvent>
    <ns2:scriptTask id="Task_KongAddress" name="Obtain Kong Address" scriptFormat="JavaScript">
      <ns2:incoming>Flow_1</ns2:incoming>
      <ns2:outgoing>Flow_2</ns2:outgoing>
      <ns2:script>execution.getProcessInstance().setVariable("KONG_ADDRESS", java.lang.System.getenv("KONG_ADDRESS"));</ns2:script>
    </ns2:scriptTask>
    <ns2:serviceTask id="Task_ComputeDischargedByZone" name="Compute Energy Discharged by Zone">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/energyanalytics/discharged-by-zone</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_2</ns2:incoming>
      <ns2:outgoing>Flow_3</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:serviceTask id="Task_ComputeGeneratedByProsumer" name="Compute Generated Energy by Prosumer">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/energyanalytics/generated-by-prosumer</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_3</ns2:incoming>
      <ns2:outgoing>Flow_4</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:serviceTask id="Task_ComputeConsumedByProsumer" name="Compute Consumed Energy by Prosumer">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/energyanalytics/consumed-by-prosumer</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_4</ns2:incoming>
      <ns2:outgoing>Flow_5</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:serviceTask id="Task_ComputeAverageSoC" name="Compute Average SoC">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/energyanalytics/average-soc</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_5</ns2:incoming>
      <ns2:outgoing>Flow_6</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:serviceTask id="Task_PublishKafka" name="Publish Analytics Results to Kafka">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/energyanalytics/publish</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_6</ns2:incoming>
      <ns2:outgoing>Flow_7</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:endEvent id="EndEvent_Done" name="Data Aggregated">
      <ns2:incoming>Flow_7</ns2:incoming>
    </ns2:endEvent>
    <ns2:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_KongAddress" />
    <ns2:sequenceFlow id="Flow_2" sourceRef="Task_KongAddress" targetRef="Task_ComputeDischargedByZone" />
    <ns2:sequenceFlow id="Flow_3" sourceRef="Task_ComputeDischargedByZone" targetRef="Task_ComputeGeneratedByProsumer" />
    <ns2:sequenceFlow id="Flow_4" sourceRef="Task_ComputeGeneratedByProsumer" targetRef="Task_ComputeConsumedByProsumer" />
    <ns2:sequenceFlow id="Flow_5" sourceRef="Task_ComputeConsumedByProsumer" targetRef="Task_ComputeAverageSoC" />
    <ns2:sequenceFlow id="Flow_6" sourceRef="Task_ComputeAverageSoC" targetRef="Task_PublishKafka" />
    <ns2:sequenceFlow id="Flow_7" sourceRef="Task_PublishKafka" targetRef="EndEvent_Done" />
  </ns2:process>
  <ns4:BPMNDiagram id="BPMNDiagram_1">
    <ns4:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_EnergyAnalytics">
      <ns4:BPMNShape id="Participant_VPPaaS_di" bpmnElement="Participant_VPPaaS" isHorizontal="true">
        <ns5:Bounds x="132" y="55" width="1118" height="200" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Lane_Executor_di" bpmnElement="Lane_Executor" isHorizontal="true">
        <ns5:Bounds x="162" y="55" width="1088" height="200" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <ns5:Bounds x="192" y="137" width="36" height="36" />
        <ns4:BPMNLabel><ns5:Bounds x="183" y="180" width="54" height="14" /></ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Task_KongAddress_di" bpmnElement="Task_KongAddress"><ns5:Bounds x="260" y="115" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Task_ComputeDischargedByZone_di" bpmnElement="Task_ComputeDischargedByZone" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <ns5:Bounds x="400" y="115" width="100" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Task_ComputeGeneratedByProsumer_di" bpmnElement="Task_ComputeGeneratedByProsumer" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <ns5:Bounds x="540" y="115" width="100" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Task_ComputeConsumedByProsumer_di" bpmnElement="Task_ComputeConsumedByProsumer" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <ns5:Bounds x="680" y="115" width="100" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Task_ComputeAverageSoC_di" bpmnElement="Task_ComputeAverageSoC" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <ns5:Bounds x="820" y="115" width="100" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="Task_PublishKafka_di" bpmnElement="Task_PublishKafka" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <ns5:Bounds x="960" y="115" width="100" height="80" />
      </ns4:BPMNShape>
      <ns4:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done">
        <ns5:Bounds x="1102" y="137" width="36" height="36" />
        <ns4:BPMNLabel><ns5:Bounds x="1080" y="180" width="80" height="14" /></ns4:BPMNLabel>
      </ns4:BPMNShape>
      <ns4:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><ns3:waypoint x="228" y="155" /><ns3:waypoint x="260" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><ns3:waypoint x="360" y="155" /><ns3:waypoint x="400" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><ns3:waypoint x="500" y="155" /><ns3:waypoint x="540" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><ns3:waypoint x="640" y="155" /><ns3:waypoint x="680" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><ns3:waypoint x="780" y="155" /><ns3:waypoint x="820" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><ns3:waypoint x="920" y="155" /><ns3:waypoint x="960" y="155" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><ns3:waypoint x="1060" y="155" /><ns3:waypoint x="1102" y="155" /></ns4:BPMNEdge>
    </ns4:BPMNPlane>
  </ns4:BPMNDiagram>
</ns2:definitions>