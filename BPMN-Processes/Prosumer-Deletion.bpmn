<?xml version="1.0" encoding="UTF-8"?>
<ns2:definitions xmlns:ns2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns3="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns4="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <ns2:collaboration id="Collaboration_ProsumerDeletion">
    <ns2:participant id="Participant_Prosumer" name="Prosumer" processRef="ProsumerDeletion" />
    <ns2:participant id="Participant_VPPaaS" name="VPPaaS" processRef="VPPaaSProsumerDeletion" />
    <ns2:messageFlow id="MsgFlow_Request" sourceRef="Send_Request" targetRef="StartEvent_VPPaaS" />
    <ns2:messageFlow id="MsgFlow_Promise" sourceRef="Send_Promise" targetRef="Catch_Promise" />
    <ns2:messageFlow id="MsgFlow_Decline" sourceRef="Send_Decline" targetRef="Catch_Decline" />
    <ns2:messageFlow id="MsgFlow_Declare" sourceRef="Send_Declare" targetRef="Catch_Declare" />
    <ns2:messageFlow id="MsgFlow_Accept" sourceRef="Send_Accept" targetRef="Catch_Accept" />
  </ns2:collaboration>

  <ns2:process id="ProsumerDeletion" name="ProsumerDeletion" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_Prosumer">
      <ns2:lane id="Lane_Initiator" name="Initiator">
        <ns2:flowNodeRef>StartEvent_Prosumer</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_FillData</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Merge</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Request</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_WaitResult</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Promise</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Decline</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Declare</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_CheckDeletion</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Accept</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Success</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_DecideNext</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Retry</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_NoRetry</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_Prosumer"><ns2:outgoing>Flow_P1</ns2:outgoing></ns2:startEvent>
    <ns2:userTask id="Task_FillData" name="Decide the ID for Prosumer Deletion order" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="ProsumerID" label="ProsumerID" type="string" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P1</ns2:incoming>
      <ns2:outgoing>Flow_P2</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Merge">
      <ns2:incoming>Flow_P2</ns2:incoming>
      <ns2:incoming>Flow_Retry_Yes</ns2:incoming>
      <ns2:outgoing>Flow_P3</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:sendTask id="Send_Request" name="Request Prosumer Deletion order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/process-definition/key/VPPaaSProsumerDeletion/start</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{"businessKey":"${execution.processBusinessKey}","variables": {"ProsumerID": {"value":"${ProsumerID}","type":"string"},"businessKeyRequester":{"value":"${execution.processBusinessKey}","type":"string"}}}</camunda:inputParameter>
            <camunda:inputParameter name="headers"><camunda:map><camunda:entry key="Content-Type">application/json</camunda:entry></camunda:map></camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P3</ns2:incoming>
      <ns2:outgoing>Flow_P4</ns2:outgoing>
    </ns2:sendTask>
    <ns2:eventBasedGateway id="Gateway_WaitResult" name="Wait for Request result">
      <ns2:incoming>Flow_P4</ns2:incoming>
      <ns2:outgoing>Flow_ToPromise</ns2:outgoing>
      <ns2:outgoing>Flow_ToDecline</ns2:outgoing>
    </ns2:eventBasedGateway>
    <ns2:intermediateCatchEvent id="Catch_Promise" name="Promise received">
      <ns2:incoming>Flow_ToPromise</ns2:incoming>
      <ns2:outgoing>Flow_P5</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Promise" messageRef="Message_ProsDelPromise" />
    </ns2:intermediateCatchEvent>
    <ns2:intermediateCatchEvent id="Catch_Decline" name="Decline received">
      <ns2:incoming>Flow_ToDecline</ns2:incoming>
      <ns2:outgoing>Flow_P_Decline</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Decline" messageRef="Message_ProsDelDecline" />
    </ns2:intermediateCatchEvent>
    <ns2:intermediateCatchEvent id="Catch_Declare" name="Declare received">
      <ns2:incoming>Flow_P5</ns2:incoming>
      <ns2:outgoing>Flow_P6</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Declare" messageRef="Message_ProsDelDeclare" />
    </ns2:intermediateCatchEvent>
    <ns2:userTask id="Task_CheckDeletion" name="Check Prosumer Deletion order" camunda:assignee="demo">
      <ns2:documentation>Please acknowledge that you have received confirmation of the deletion.</ns2:documentation>
      <ns2:extensionElements>
        <camunda:formData>
          <camunda:formField id="ProsumerID" label="ProsumerID Deleted" type="string" defaultValue="${ProsumerID}" />
        </camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P6</ns2:incoming>
      <ns2:outgoing>Flow_P7</ns2:outgoing>
    </ns2:userTask>
    <ns2:sendTask id="Send_Accept" name="Accept Prosumer Deletion order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{"messageName":"Message_ProsDelAccept","businessKey":"${execution.processBusinessKey}","resultEnabled":true}</camunda:inputParameter>
            <camunda:inputParameter name="headers"><camunda:map><camunda:entry key="Content-Type">application/json</camunda:entry></camunda:map></camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P7</ns2:incoming>
      <ns2:outgoing>Flow_P8</ns2:outgoing>
    </ns2:sendTask>
    <ns2:endEvent id="EndEvent_Success"><ns2:incoming>Flow_P8</ns2:incoming></ns2:endEvent>
    <ns2:userTask id="Task_DecideNext" name="Decide what to do next" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData><camunda:formField id="newrequest" label="newrequest" type="boolean" /></camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_P_Decline</ns2:incoming>
      <ns2:outgoing>Flow_P_Decision</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Retry" name="Make new request?">
      <ns2:incoming>Flow_P_Decision</ns2:incoming>
      <ns2:outgoing>Flow_Retry_Yes</ns2:outgoing>
      <ns2:outgoing>Flow_Retry_No</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:endEvent id="EndEvent_NoRetry"><ns2:incoming>Flow_Retry_No</ns2:incoming></ns2:endEvent>
    <ns2:sequenceFlow id="Flow_P1" sourceRef="StartEvent_Prosumer" targetRef="Task_FillData" />
    <ns2:sequenceFlow id="Flow_P2" sourceRef="Task_FillData" targetRef="Gateway_Merge" />
    <ns2:sequenceFlow id="Flow_P3" sourceRef="Gateway_Merge" targetRef="Send_Request" />
    <ns2:sequenceFlow id="Flow_P4" sourceRef="Send_Request" targetRef="Gateway_WaitResult" />
    <ns2:sequenceFlow id="Flow_ToPromise" sourceRef="Gateway_WaitResult" targetRef="Catch_Promise" />
    <ns2:sequenceFlow id="Flow_ToDecline" sourceRef="Gateway_WaitResult" targetRef="Catch_Decline" />
    <ns2:sequenceFlow id="Flow_P5" sourceRef="Catch_Promise" targetRef="Catch_Declare" />
    <ns2:sequenceFlow id="Flow_P6" sourceRef="Catch_Declare" targetRef="Task_CheckDeletion" />
    <ns2:sequenceFlow id="Flow_P7" sourceRef="Task_CheckDeletion" targetRef="Send_Accept" />
    <ns2:sequenceFlow id="Flow_P8" sourceRef="Send_Accept" targetRef="EndEvent_Success" />
    <ns2:sequenceFlow id="Flow_P_Decline" sourceRef="Catch_Decline" targetRef="Task_DecideNext" />
    <ns2:sequenceFlow id="Flow_P_Decision" sourceRef="Task_DecideNext" targetRef="Gateway_Retry" />
    <ns2:sequenceFlow id="Flow_Retry_Yes" name="Yes" sourceRef="Gateway_Retry" targetRef="Gateway_Merge"><ns2:conditionExpression xsi:type="ns2:tFormalExpression">${newrequest}</ns2:conditionExpression></ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_Retry_No" name="No" sourceRef="Gateway_Retry" targetRef="EndEvent_NoRetry"><ns2:conditionExpression xsi:type="ns2:tFormalExpression">${!newrequest}</ns2:conditionExpression></ns2:sequenceFlow>
  </ns2:process>

  <ns2:process id="VPPaaSProsumerDeletion" name="VPPaaSProsumerDeletion" isExecutable="true" camunda:historyTimeToLive="180">
    <ns2:laneSet id="LaneSet_VPPaaS">
      <ns2:lane id="Lane_Executor" name="Executor">
        <ns2:flowNodeRef>StartEvent_VPPaaS</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_Verify</ns2:flowNodeRef>
        <ns2:flowNodeRef>Gateway_Approve</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Promise</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_KongAddress</ns2:flowNodeRef>
        <ns2:flowNodeRef>Task_DeleteProsumer</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Declare</ns2:flowNodeRef>
        <ns2:flowNodeRef>Catch_Accept</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Executor</ns2:flowNodeRef>
        <ns2:flowNodeRef>Send_Decline</ns2:flowNodeRef>
        <ns2:flowNodeRef>EndEvent_Declined</ns2:flowNodeRef>
      </ns2:lane>
    </ns2:laneSet>
    <ns2:startEvent id="StartEvent_VPPaaS" name="Request received">
      <ns2:outgoing>Flow_V1</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Request" messageRef="Message_ProsDelRequest" />
    </ns2:startEvent>
    <ns2:userTask id="Task_Verify" name="Verify if execute deletion is possible" camunda:assignee="demo">
      <ns2:extensionElements>
        <camunda:formData><camunda:formField id="promise" label="promise" type="boolean" defaultValue="true" /></camunda:formData>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V1</ns2:incoming>
      <ns2:outgoing>Flow_V2</ns2:outgoing>
    </ns2:userTask>
    <ns2:exclusiveGateway id="Gateway_Approve" name="ok to delete?">
      <ns2:incoming>Flow_V2</ns2:incoming>
      <ns2:outgoing>Flow_Approve_Yes</ns2:outgoing>
      <ns2:outgoing>Flow_Approve_No</ns2:outgoing>
    </ns2:exclusiveGateway>
    <ns2:sendTask id="Send_Promise" name="Promise Prosumer Deletion order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="payload">{"messageName":"Message_ProsDelPromise","businessKey":"${businessKeyRequester}","resultEnabled":true}</camunda:inputParameter>
            <camunda:inputParameter name="headers"><camunda:map><camunda:entry key="Content-Type">application/json</camunda:entry></camunda:map></camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_Approve_Yes</ns2:incoming>
      <ns2:outgoing>Flow_V3</ns2:outgoing>
    </ns2:sendTask>
    <ns2:scriptTask id="Task_KongAddress" name="Obtain Kong Address" scriptFormat="JavaScript">
      <ns2:incoming>Flow_V3</ns2:incoming>
      <ns2:outgoing>Flow_V4</ns2:outgoing>
      <ns2:script>execution.getProcessInstance().setVariable("KONG_ADDRESS", java.lang.System.getenv("KONG_ADDRESS"));</ns2:script>
    </ns2:scriptTask>
    <ns2:serviceTask id="Task_DeleteProsumer" name="Delete Prosumer">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
            <camunda:inputParameter name="url">http://${KONG_ADDRESS}:8000/Prosumer/${ProsumerID}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map><camunda:entry key="accept">application/json</camunda:entry></camunda:map>
            </camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V4</ns2:incoming>
      <ns2:outgoing>Flow_V5</ns2:outgoing>
    </ns2:serviceTask>
    <ns2:sendTask id="Send_Declare" name="Declare Prosumer Deletion order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">{"messageName":"Message_ProsDelDeclare","businessKey":"${businessKeyRequester}","resultEnabled":true}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="headers"><camunda:map><camunda:entry key="Content-Type">application/json</camunda:entry></camunda:map></camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_V5</ns2:incoming>
      <ns2:outgoing>Flow_V6</ns2:outgoing>
    </ns2:sendTask>
    <ns2:intermediateCatchEvent id="Catch_Accept" name="Accept received">
      <ns2:incoming>Flow_V6</ns2:incoming>
      <ns2:outgoing>Flow_V7</ns2:outgoing>
      <ns2:messageEventDefinition id="EvDef_Accept" messageRef="Message_ProsDelAccept" />
    </ns2:intermediateCatchEvent>
    <ns2:endEvent id="EndEvent_Executor"><ns2:incoming>Flow_V7</ns2:incoming></ns2:endEvent>
    <ns2:sendTask id="Send_Decline" name="Decline Prosumer Deletion order">
      <ns2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">{"messageName":"Message_ProsDelDecline","businessKey":"${businessKeyRequester}","resultEnabled":true}</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8080/engine-rest/message</camunda:inputParameter>
            <camunda:inputParameter name="headers"><camunda:map><camunda:entry key="Content-Type">application/json</camunda:entry></camunda:map></camunda:inputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </ns2:extensionElements>
      <ns2:incoming>Flow_Approve_No</ns2:incoming>
      <ns2:outgoing>Flow_V_Decline</ns2:outgoing>
    </ns2:sendTask>
    <ns2:endEvent id="EndEvent_Declined"><ns2:incoming>Flow_V_Decline</ns2:incoming></ns2:endEvent>
    <ns2:sequenceFlow id="Flow_V1" sourceRef="StartEvent_VPPaaS" targetRef="Task_Verify" />
    <ns2:sequenceFlow id="Flow_V2" sourceRef="Task_Verify" targetRef="Gateway_Approve" />
    <ns2:sequenceFlow id="Flow_Approve_Yes" name="Yes" sourceRef="Gateway_Approve" targetRef="Send_Promise"><ns2:conditionExpression xsi:type="ns2:tFormalExpression">${promise}</ns2:conditionExpression></ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_Approve_No" name="No" sourceRef="Gateway_Approve" targetRef="Send_Decline"><ns2:conditionExpression xsi:type="ns2:tFormalExpression">${!promise}</ns2:conditionExpression></ns2:sequenceFlow>
    <ns2:sequenceFlow id="Flow_V3" sourceRef="Send_Promise" targetRef="Task_KongAddress" />
    <ns2:sequenceFlow id="Flow_V4" sourceRef="Task_KongAddress" targetRef="Task_DeleteProsumer" />
    <ns2:sequenceFlow id="Flow_V5" sourceRef="Task_DeleteProsumer" targetRef="Send_Declare" />
    <ns2:sequenceFlow id="Flow_V6" sourceRef="Send_Declare" targetRef="Catch_Accept" />
    <ns2:sequenceFlow id="Flow_V7" sourceRef="Catch_Accept" targetRef="EndEvent_Executor" />
    <ns2:sequenceFlow id="Flow_V_Decline" sourceRef="Send_Decline" targetRef="EndEvent_Declined" />
  </ns2:process>

  <ns2:message id="Message_ProsDelRequest" name="Message_ProsDelRequest" />
  <ns2:message id="Message_ProsDelPromise" name="Message_ProsDelPromise" />
  <ns2:message id="Message_ProsDelDecline" name="Message_ProsDelDecline" />
  <ns2:message id="Message_ProsDelDeclare" name="Message_ProsDelDeclare" />
  <ns2:message id="Message_ProsDelAccept" name="Message_ProsDelAccept" />

  <ns4:BPMNDiagram id="BPMNDiagram_ProsDeletion">
    <ns4:BPMNPlane id="BPMNPlane_ProsDeletion" bpmnElement="Collaboration_ProsumerDeletion">
      <ns4:BPMNShape id="Participant_Prosumer_di" bpmnElement="Participant_Prosumer" isHorizontal="true"><ns5:Bounds x="200" y="80" width="1400" height="300" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Lane_Initiator_di" bpmnElement="Lane_Initiator" isHorizontal="true"><ns5:Bounds x="230" y="80" width="1370" height="300" /></ns4:BPMNShape>
      <ns4:BPMNShape id="StartEvent_Prosumer_di" bpmnElement="StartEvent_Prosumer"><ns5:Bounds x="262" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Task_FillData_di" bpmnElement="Task_FillData"><ns5:Bounds x="340" y="125" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true"><ns5:Bounds x="490" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Send_Request_di" bpmnElement="Send_Request" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311"><ns5:Bounds x="570" y="125" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_WaitResult_di" bpmnElement="Gateway_WaitResult"><ns5:Bounds x="720" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Catch_Promise_di" bpmnElement="Catch_Promise"><ns5:Bounds x="832" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Catch_Declare_di" bpmnElement="Catch_Declare"><ns5:Bounds x="942" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Task_CheckDeletion_di" bpmnElement="Task_CheckDeletion"><ns5:Bounds x="1050" y="125" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Send_Accept_di" bpmnElement="Send_Accept" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311"><ns5:Bounds x="1220" y="125" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success"><ns5:Bounds x="1380" y="147" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Catch_Decline_di" bpmnElement="Catch_Decline"><ns5:Bounds x="720" y="302" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Task_DecideNext_di" bpmnElement="Task_DecideNext"><ns5:Bounds x="590" y="280" width="100" height="80" /></ns4:BPMNShape>
      <ns4:BPMNShape id="Gateway_Retry_di" bpmnElement="Gateway_Retry" isMarkerVisible="true"><ns5:Bounds x="490" y="302" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNShape id="EndEvent_NoRetry_di" bpmnElement="EndEvent_NoRetry"><ns5:Bounds x="402" y="302" width="36" height="36" /></ns4:BPMNShape>
      <ns4:BPMNEdge id="Flow_P1_di" bpmnElement="Flow_P1"><ns3:waypoint x="298" y="165" /><ns3:waypoint x="340" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P2_di" bpmnElement="Flow_P2"><ns3:waypoint x="440" y="165" /><ns3:waypoint x="490" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P3_di" bpmnElement="Flow_P3"><ns3:waypoint x="526" y="165" /><ns3:waypoint x="570" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P4_di" bpmnElement="Flow_P4"><ns3:waypoint x="670" y="165" /><ns3:waypoint x="720" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_ToPromise_di" bpmnElement="Flow_ToPromise"><ns3:waypoint x="756" y="165" /><ns3:waypoint x="832" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_ToDecline_di" bpmnElement="Flow_ToDecline"><ns3:waypoint x="738" y="183" /><ns3:waypoint x="738" y="302" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P5_di" bpmnElement="Flow_P5"><ns3:waypoint x="868" y="165" /><ns3:waypoint x="942" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P6_di" bpmnElement="Flow_P6"><ns3:waypoint x="978" y="165" /><ns3:waypoint x="1050" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P7_di" bpmnElement="Flow_P7"><ns3:waypoint x="1150" y="165" /><ns3:waypoint x="1220" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P8_di" bpmnElement="Flow_P8"><ns3:waypoint x="1320" y="165" /><ns3:waypoint x="1380" y="165" /></ns4:BPMNEdge>
      <ns4:BPMNEdge id="Flow_P_Decline_di" bpmnElement="Flow_P_Decline"><ns3:waypoint x="720" y="320" /><ns3:waypoint x="690" y="320" /></ns4:BPMNEdge>
