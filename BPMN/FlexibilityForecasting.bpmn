<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_FlexibilityForecasting" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_FlexibilityForecasting">
    <bpmn:participant id="Participant_FlexibilityForecasting" name="Flexibility Forecasting" processRef="FlexibilityForecasting" />
  </bpmn:collaboration>
  <bpmn:process id="FlexibilityForecasting" isExecutable="true">
    <bpmn:laneSet id="LaneSet_FlexibilityForecasting">
      <bpmn:lane id="Lane_FF_Initiator" name="VPP Operator - Initiator TK01">
        <bpmn:flowNodeRef>Event_FF_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_FF_RequestForecast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_FF_ReviewForecast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FF_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FF_End_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FF_End_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FF_Executor" name="VPP Operator - Executor TK01">
        <bpmn:flowNodeRef>Activity_FF_GenerateForecast</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_FF_Start">
      <bpmn:outgoing>Flow_FF_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_FF_RequestForecast" name="Request Flexibility Forecast">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_Request_FlexibilityForecasting" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FF_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_FF_Request_Generate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_FF_GenerateForecast" name="Generate AI Forecast" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://KONG_DNS_PLACEHOLDER:8000/FlexibilityForecasting/forecast" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;:&#34;application/json&#34;,&#34;accept&#34;:&#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={}" target="body" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=180" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="ignoreNullValues" />
          <zeebe:output source="=httpResponse.body.forecast" target="forecastText" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="httpResponse" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FF_Request_Generate</bpmn:incoming>
      <bpmn:outgoing>Flow_FF_Generate_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_FF_ReviewForecast" name="Review Forecast Results">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_ReviewForecast" />
        <zeebe:ioMapping>
          <zeebe:input source="=forecastText" target="forecastText" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FF_Generate_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_FF_Review_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FF_Approved" name="Approved?">
      <bpmn:incoming>Flow_FF_Review_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_FF_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_FF_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_FF_End_Approved" name="Forecast Approved">
      <bpmn:incoming>Flow_FF_Approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_FF_End_Rejected" name="Forecast Rejected">
      <bpmn:incoming>Flow_FF_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_FF_Start_Request" sourceRef="Event_FF_Start" targetRef="Activity_FF_RequestForecast" />
    <bpmn:sequenceFlow id="Flow_FF_Request_Generate" sourceRef="Activity_FF_RequestForecast" targetRef="Activity_FF_GenerateForecast" />
    <bpmn:sequenceFlow id="Flow_FF_Generate_Review" sourceRef="Activity_FF_GenerateForecast" targetRef="Activity_FF_ReviewForecast" />
    <bpmn:sequenceFlow id="Flow_FF_Review_Gateway" sourceRef="Activity_FF_ReviewForecast" targetRef="Gateway_FF_Approved" />
    <bpmn:sequenceFlow id="Flow_FF_Approved" name="Yes" sourceRef="Gateway_FF_Approved" targetRef="Event_FF_End_Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FF_Rejected" name="No" sourceRef="Gateway_FF_Approved" targetRef="Event_FF_End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FlexibilityForecasting">
    <bpmndi:BPMNPlane id="BPMNPlane_FlexibilityForecasting" bpmnElement="Collaboration_FlexibilityForecasting">
      <bpmndi:BPMNShape id="Participant_FlexibilityForecasting_di" bpmnElement="Participant_FlexibilityForecasting" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1100" height="340" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FF_Initiator_di" bpmnElement="Lane_FF_Initiator" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1070" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_FF_Executor_di" bpmnElement="Lane_FF_Executor" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1070" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_FF_Start_di" bpmnElement="Event_FF_Start">
        <dc:Bounds x="242" y="147" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_FF_RequestForecast_di" bpmnElement="Activity_FF_RequestForecast">
        <dc:Bounds x="330" y="125" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_FF_GenerateForecast_di" bpmnElement="Activity_FF_GenerateForecast" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="490" y="295" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_FF_ReviewForecast_di" bpmnElement="Activity_FF_ReviewForecast">
        <dc:Bounds x="650" y="125" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FF_Approved_di" bpmnElement="Gateway_FF_Approved" isMarkerVisible="true">
        <dc:Bounds x="825" y="140" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="818" y="116" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_FF_End_Approved_di" bpmnElement="Event_FF_End_Approved">
        <dc:Bounds x="952" y="147" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="929" y="190" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_FF_End_Rejected_di" bpmnElement="Event_FF_End_Rejected">
        <dc:Bounds x="952" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="929" y="255" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_FF_Start_Request_di" bpmnElement="Flow_FF_Start_Request">
        <di:waypoint x="278" y="165" />
        <di:waypoint x="330" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FF_Request_Generate_di" bpmnElement="Flow_FF_Request_Generate">
        <di:waypoint x="380" y="205" />
        <di:waypoint x="380" y="335" />
        <di:waypoint x="490" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FF_Generate_Review_di" bpmnElement="Flow_FF_Generate_Review">
        <di:waypoint x="540" y="295" />
        <di:waypoint x="540" y="165" />
        <di:waypoint x="650" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FF_Review_Gateway_di" bpmnElement="Flow_FF_Review_Gateway">
        <di:waypoint x="750" y="165" />
        <di:waypoint x="825" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FF_Approved_di" bpmnElement="Flow_FF_Approved">
        <di:waypoint x="875" y="165" />
        <di:waypoint x="952" y="165" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="906" y="147" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FF_Rejected_di" bpmnElement="Flow_FF_Rejected">
        <di:waypoint x="850" y="190" />
        <di:waypoint x="850" y="230" />
        <di:waypoint x="952" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="858" y="207" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
