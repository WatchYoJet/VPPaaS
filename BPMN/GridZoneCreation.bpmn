<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_GridZoneCreation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_GridZoneCreation">
    <bpmn:participant id="Participant_GridZoneCreation" name="Grid Zone Creation" processRef="GridZoneCreation" />
  </bpmn:collaboration>
  <bpmn:process id="GridZoneCreation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_GridZoneCreation">
      <bpmn:lane id="Lane_GZ_Initiator" name="Utility Operator - Initiator TK01">
        <bpmn:flowNodeRef>Event_GZ_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_GZ_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GZ_Executor" name="VPP Manager - Executor TK01">
        <bpmn:flowNodeRef>Activity_GZ_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Promise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GZ_Declare</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="Event_GZ_End">
      <bpmn:incoming>Flow_GZ_Accept_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_GZ_Verify" name="Verify if Grid Zone Creation is possible">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_Promise_GridZoneCreation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GZ_Request_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Verify_Promise</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_GZ_Check" name="Check Grid Zone Creation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_Productok_GridZoneCreation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GZ_Declare_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Check_Accept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_GZ_Create" name="Create Grid Zone" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://KONG_DNS_PLACEHOLDER:8000/GridZone" target="url" />
          <zeebe:input source="={&#10;  &#34;Content-Type&#34;:&#34;application/json&#34;,&#10;  &#34;accept&#34;:&#34;application/json&#34;&#10;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#34;name&#34;:name,&#34;utilityOperatorId&#34;:utilityOperatorId,&#34;maxCapacity&#34;:maxCapacity,&#34;boundaries&#34;:&#34;&#34;,&#34;safetyThreshold&#34;:safetyThreshold,&#34;postalCode&#34;:postalCode}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GZ_Promise_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Create_Declare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Event_GZ_Start">
      <bpmn:outgoing>Flow_GZ_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_GZ_Request" name="Request Grid Zone Creation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:formDefinition formId="Form_Request_GridZoneCreation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GZ_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Request_Verify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_GZ_Promise" name="Promise Grid Zone Creation">
      <bpmn:incoming>Flow_GZ_Verify_Promise</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Promise_Create</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_GZ_Declare" name="Declare Grid Zone Creation">
      <bpmn:incoming>Flow_GZ_Create_Declare</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Declare_Check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_GZ_Accept" name="Accept Grid Zone Creation">
      <bpmn:incoming>Flow_GZ_Check_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_GZ_Accept_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_GZ_Accept_End" sourceRef="Activity_GZ_Accept" targetRef="Event_GZ_End" />
    <bpmn:sequenceFlow id="Flow_GZ_Request_Verify" sourceRef="Activity_GZ_Request" targetRef="Activity_GZ_Verify" />
    <bpmn:sequenceFlow id="Flow_GZ_Verify_Promise" sourceRef="Activity_GZ_Verify" targetRef="Activity_GZ_Promise" />
    <bpmn:sequenceFlow id="Flow_GZ_Declare_Check" sourceRef="Activity_GZ_Declare" targetRef="Activity_GZ_Check" />
    <bpmn:sequenceFlow id="Flow_GZ_Check_Accept" sourceRef="Activity_GZ_Check" targetRef="Activity_GZ_Accept" />
    <bpmn:sequenceFlow id="Flow_GZ_Promise_Create" sourceRef="Activity_GZ_Promise" targetRef="Activity_GZ_Create" />
    <bpmn:sequenceFlow id="Flow_GZ_Create_Declare" sourceRef="Activity_GZ_Create" targetRef="Activity_GZ_Declare" />
    <bpmn:sequenceFlow id="Flow_GZ_Start_Request" sourceRef="Event_GZ_Start" targetRef="Activity_GZ_Request" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GridZoneCreation">
    <bpmndi:BPMNPlane id="BPMNPlane_GridZoneCreation" bpmnElement="Collaboration_GridZoneCreation">
      <bpmndi:BPMNShape id="Participant_GridZoneCreation_di" bpmnElement="Participant_GridZoneCreation" isHorizontal="true">
        <dc:Bounds x="160" y="120" width="929" height="340" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GZ_Executor_di" bpmnElement="Lane_GZ_Executor" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="899" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GZ_Initiator_di" bpmnElement="Lane_GZ_Initiator" isHorizontal="true">
        <dc:Bounds x="190" y="120" width="899" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_GZ_End_di" bpmnElement="Event_GZ_End">
        <dc:Bounds x="1030" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Verify_di" bpmnElement="Activity_GZ_Verify">
        <dc:Bounds x="305" y="335" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Check_di" bpmnElement="Activity_GZ_Check">
        <dc:Bounds x="755" y="165" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Create_di" bpmnElement="Activity_GZ_Create" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="605" y="335" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_GZ_Start_di" bpmnElement="Event_GZ_Start">
        <dc:Bounds x="241" y="187" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Request_di" bpmnElement="Activity_GZ_Request">
        <dc:Bounds x="305" y="165" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Promise_di" bpmnElement="Activity_GZ_Promise">
        <dc:Bounds x="455" y="335" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Declare_di" bpmnElement="Activity_GZ_Declare">
        <dc:Bounds x="749" y="335" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GZ_Accept_di" bpmnElement="Activity_GZ_Accept">
        <dc:Bounds x="880" y="165" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_GZ_Accept_End" bpmnElement="Flow_GZ_Accept_End">
        <di:waypoint x="980" y="205" />
        <di:waypoint x="1030" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Request_Verify" bpmnElement="Flow_GZ_Request_Verify">
        <di:waypoint x="355" y="245" />
        <di:waypoint x="355" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Verify_Promise" bpmnElement="Flow_GZ_Verify_Promise">
        <di:waypoint x="405" y="375" />
        <di:waypoint x="455" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Declare_Check" bpmnElement="Flow_GZ_Declare_Check">
        <di:waypoint x="798" y="335" />
        <di:waypoint x="798" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Check_Accept" bpmnElement="Flow_GZ_Check_Accept">
        <di:waypoint x="855" y="205" />
        <di:waypoint x="880" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Promise_Create" bpmnElement="Flow_GZ_Promise_Create">
        <di:waypoint x="555" y="375" />
        <di:waypoint x="605" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Create_Declare" bpmnElement="Flow_GZ_Create_Declare">
        <di:waypoint x="705" y="375" />
        <di:waypoint x="749" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_GZ_Start_Request" bpmnElement="Flow_GZ_Start_Request">
        <di:waypoint x="277" y="205" />
        <di:waypoint x="305" y="205" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
