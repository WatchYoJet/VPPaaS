<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Del" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_Del">
    <bpmn:participant id="Participant_DelInit" name="PROSUMER" processRef="ProsumerDeletionInitiator" />
    <bpmn:participant id="Participant_DelExec" name="PROSUMER MANAGER" processRef="ProsumerDeletionExecutor" />
    <bpmn:messageFlow id="MsgFlow_Del_Req" sourceRef="Task_Del_SendReq" targetRef="StartEvt_DelExec" />
    <bpmn:messageFlow id="MsgFlow_Del_Decline" sourceRef="Task_Del_Decline" targetRef="MsgCatch_Del_Decline" />
    <bpmn:messageFlow id="MsgFlow_Del_Declare" sourceRef="Task_Del_Declare" targetRef="MsgCatch_Del_Declare" />
    <bpmn:messageFlow id="MsgFlow_Del_Accept" sourceRef="Task_Del_Accept" targetRef="MsgCatch_Del_Accept" />
    <bpmn:messageFlow id="MsgFlow_Del_Reject" sourceRef="Task_Del_Reject" targetRef="MsgCatch_Del_Reject" />
  </bpmn:collaboration>
  <bpmn:process id="ProsumerDeletionInitiator" name="ProsumerDeletionInitiator" isExecutable="true">
    <bpmn:laneSet id="LaneSet_DelInit">
      <bpmn:lane id="Lane_DelInit" name="Initiator TK01">
        <bpmn:flowNodeRef>StartEvt_DelInit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_SelectProsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_SendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Del_WaitResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Del_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Del_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Del_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Del_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Del_Declare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Del_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvt_DelInit" name="Start deletion">
      <bpmn:outgoing>Flow_Di_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Del_SelectProsumer" name="Select Prosumer to Delete">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Request_ProsumerDeletion" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Di_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Del_SendReq" name="Request Prosumer Deletion" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/process-instances" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;Application/json&#34;, &#34;accept&#34;: &#34;Application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#34;processDefinitionId&#34;: &#34;ProsumerDeletionExecutor&#34;, &#34;variables&#34;: {&#34;prosumerId&#34;: prosumerId}}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Di_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_Del_WaitResp" name="Wait for response">
      <bpmn:incoming>Flow_Di_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Di_4b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="MsgCatch_Del_Decline" name="Decline received">
      <bpmn:incoming>Flow_Di_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_5a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Del_Decline_Init" messageRef="Msg_Del_Decline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvt_Del_Declined" name="Declined">
      <bpmn:incoming>Flow_Di_5a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Del_Decision" name="Accept deletion?">
      <bpmn:incoming>Flow_Di_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_7a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Di_7b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvt_Del_Done" name="Done">
      <bpmn:incoming>Flow_Di_8a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Di_1" sourceRef="StartEvt_DelInit" targetRef="Task_Del_SelectProsumer" />
    <bpmn:sequenceFlow id="Flow_Di_2" sourceRef="Task_Del_SelectProsumer" targetRef="Task_Del_SendReq" />
    <bpmn:sequenceFlow id="Flow_Di_3" sourceRef="Task_Del_SendReq" targetRef="GW_Del_WaitResp" />
    <bpmn:sequenceFlow id="Flow_Di_4a" sourceRef="GW_Del_WaitResp" targetRef="MsgCatch_Del_Decline" />
    <bpmn:sequenceFlow id="Flow_Di_4b" sourceRef="GW_Del_WaitResp" targetRef="MsgCatch_Del_Declare" />
    <bpmn:sequenceFlow id="Flow_Di_5a" sourceRef="MsgCatch_Del_Decline" targetRef="EndEvt_Del_Declined" />
    <bpmn:sequenceFlow id="Flow_Di_5b" sourceRef="MsgCatch_Del_Declare" targetRef="Task_Del_Confirm" />
    <bpmn:sequenceFlow id="Flow_Di_6" sourceRef="Task_Del_Confirm" targetRef="GW_Del_Decision" />
    <bpmn:sequenceFlow id="Flow_Di_7a" name="Yes" sourceRef="GW_Del_Decision" targetRef="Task_Del_Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accept</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Di_7b" name="No" sourceRef="GW_Del_Decision" targetRef="Task_Del_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(accept)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Di_8a" sourceRef="Task_Del_Accept" targetRef="EndEvt_Del_Done" />
    <bpmn:sequenceFlow id="Flow_Di_8b" sourceRef="Task_Del_Reject" targetRef="EndEvt_Del_Rejected" />
    <bpmn:userTask id="Task_Del_Confirm" name="Confirm Deletion">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Confirm_ProsumerDeletion" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Di_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="MsgCatch_Del_Declare" name="Declare received">
      <bpmn:incoming>Flow_Di_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_5b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Del_Declare_Init" messageRef="Msg_Del_Declare" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Del_Accept" name="Accept Deletion Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;Application/json&#34;, &#34;accept&#34;: &#34;Application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#34;name&#34;: &#34;Msg_Del_Accept&#34;, &#34;correlationKey&#34;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Di_7a</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_8a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Del_Reject" name="Reject Deletion Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;Application/json&#34;, &#34;accept&#34;: &#34;Application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#34;name&#34;: &#34;Msg_Del_Reject&#34;, &#34;correlationKey&#34;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Di_7b</bpmn:incoming>
      <bpmn:outgoing>Flow_Di_8b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvt_Del_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Di_8b</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="ProsumerDeletionExecutor" name="ProsumerDeletionExecutor" isExecutable="true">
    <bpmn:laneSet id="LaneSet_DelExec">
      <bpmn:lane id="Lane_DelExec" name="Executor TK02">
        <bpmn:flowNodeRef>StartEvt_DelExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_FetchProsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_ReviewReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_DelExec_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_DeleteProsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_Declare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Del_WaitResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Del_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Del_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_DelExec_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_DelExec_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Del_Promise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Del_Decline</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvt_DelExec" name="Request received">
      <bpmn:outgoing>Flow_De_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Del_FetchProsumer" name="Fetch Prosumer Data" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&#34;http://KONG_DNS_PLACEHOLDER:8000/Prosumer/&#34; + string(prosumerId)" target="url" />
          <zeebe:input source="={&#34;accept&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="=true" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ prosumerData: response.body }" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_De_1</bpmn:incoming>
      <bpmn:outgoing>Flow_De_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Del_ReviewReq" name="Review Deletion Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Promise_ProsumerDeletion" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_De_2</bpmn:incoming>
      <bpmn:outgoing>Flow_De_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvt_DelExec_Declined" name="Declined">
      <bpmn:incoming>Flow_De_5a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Del_DeleteProsumer" name="Delete Prosumer" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="DELETE" target="method" />
          <zeebe:input source="=&#34;http://KONG_DNS_PLACEHOLDER:8000/Prosumer/&#34; + string(prosumerId)" target="url" />
          <zeebe:input source="={&#34;accept&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_De_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_De_5b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Del_Declare" name="Declare Deletion Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;Application/json&#34;, &#34;accept&#34;: &#34;Application/json&#34;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#34;name&#34;: &#34;Msg_Del_Declare&#34;, &#34;correlationKey&#34;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_De_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_De_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_Del_WaitResult" name="Wait for result">
      <bpmn:incoming>Flow_De_6</bpmn:incoming>
      <bpmn:outgoing>Flow_De_7a</bpmn:outgoing>
      <bpmn:outgoing>Flow_De_7b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="MsgCatch_Del_Accept" name="Accept received">
      <bpmn:incoming>Flow_De_7a</bpmn:incoming>
      <bpmn:outgoing>Flow_De_8a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Del_Accept_Exec" messageRef="Msg_Del_Accept" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="MsgCatch_Del_Reject" name="Reject received">
      <bpmn:incoming>Flow_De_7b</bpmn:incoming>
      <bpmn:outgoing>Flow_De_8b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Del_Reject_Exec" messageRef="Msg_Del_Reject" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvt_DelExec_Accepted" name="Accepted">
      <bpmn:incoming>Flow_De_8a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvt_DelExec_Rejected" name="Rejected">
      <bpmn:incoming>Flow_De_8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_De_1" sourceRef="StartEvt_DelExec" targetRef="Task_Del_FetchProsumer" />
    <bpmn:sequenceFlow id="Flow_De_2" sourceRef="Task_Del_FetchProsumer" targetRef="Task_Del_ReviewReq" />
    <bpmn:sequenceFlow id="Flow_De_3" sourceRef="Task_Del_ReviewReq" targetRef="GW_Del_Promise" />
    <bpmn:sequenceFlow id="Flow_De_4a" name="No" sourceRef="GW_Del_Promise" targetRef="Task_Del_Decline">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(promise)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_De_4b" name="Yes" sourceRef="GW_Del_Promise" targetRef="Task_Del_DeleteProsumer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=promise</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_De_5a" sourceRef="Task_Del_Decline" targetRef="EndEvt_DelExec_Declined" />
    <bpmn:sequenceFlow id="Flow_De_5b" sourceRef="Task_Del_DeleteProsumer" targetRef="Task_Del_Declare" />
    <bpmn:sequenceFlow id="Flow_De_6" sourceRef="Task_Del_Declare" targetRef="GW_Del_WaitResult" />
    <bpmn:sequenceFlow id="Flow_De_7a" sourceRef="GW_Del_WaitResult" targetRef="MsgCatch_Del_Accept" />
    <bpmn:sequenceFlow id="Flow_De_7b" sourceRef="GW_Del_WaitResult" targetRef="MsgCatch_Del_Reject" />
    <bpmn:sequenceFlow id="Flow_De_8a" sourceRef="MsgCatch_Del_Accept" targetRef="EndEvt_DelExec_Accepted" />
    <bpmn:sequenceFlow id="Flow_De_8b" sourceRef="MsgCatch_Del_Reject" targetRef="EndEvt_DelExec_Rejected" />
    <bpmn:exclusiveGateway id="GW_Del_Promise" name="Promise deletion?">
      <bpmn:incoming>Flow_De_3</bpmn:incoming>
      <bpmn:outgoing>Flow_De_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_De_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Del_Decline" name="Decline Deletion Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
