<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_Upd"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.47.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.8.0">

  <bpmn:collaboration id="Collaboration_Upd">
    <bpmn:participant id="Participant_UpdInit" name="PROSUMER" processRef="ProsumerUpdateInitiator" />
    <bpmn:participant id="Participant_UpdExec" name="PROSUMER MANAGER" processRef="ProsumerUpdateExecutor" />
    <bpmn:messageFlow id="MsgFlow_Upd_Req" sourceRef="Task_Upd_SendReq" targetRef="StartEvt_UpdExec" />
    <bpmn:messageFlow id="MsgFlow_Upd_Decline" sourceRef="Task_Upd_Decline" targetRef="MsgCatch_Upd_Decline" />
    <bpmn:messageFlow id="MsgFlow_Upd_Declare" sourceRef="Task_Upd_Declare" targetRef="MsgCatch_Upd_Declare" />
    <bpmn:messageFlow id="MsgFlow_Upd_Accept" sourceRef="Task_Upd_Accept" targetRef="MsgCatch_Upd_Accept" />
    <bpmn:messageFlow id="MsgFlow_Upd_Reject" sourceRef="Task_Upd_Reject" targetRef="MsgCatch_Upd_Reject" />
  </bpmn:collaboration>

  <!-- INITIATOR PROCESS -->
  <bpmn:process id="ProsumerUpdateInitiator" name="ProsumerUpdateInitiator" isExecutable="true">
    <bpmn:laneSet id="LaneSet_UpdInit">
      <bpmn:lane id="Lane_UpdInit" name="Initiator TK01">
        <bpmn:flowNodeRef>StartEvt_UpdInit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_EnterData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_SendReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Upd_WaitResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Upd_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Upd_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Upd_Declare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Upd_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Upd_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_Upd_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvt_UpdInit" name="Start update">
      <bpmn:outgoing>Flow_Ui_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Upd_EnterData" name="Enter New Prosumer Data">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Request_ProsumerUpdate" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ui_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Upd_SendReq" name="Request Prosumer Update" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/process-instances" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;Application/json&quot;, &quot;accept&quot;: &quot;Application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&quot;processDefinitionId&quot;: &quot;ProsumerUpdateExecutor&quot;, &quot;variables&quot;: {&quot;prosumerId&quot;: prosumerId, &quot;name&quot;: name, &quot;fiscalnumber&quot;: fiscalnumber, &quot;location&quot;: location}}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ui_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:eventBasedGateway id="GW_Upd_WaitResp" name="Wait for response">
      <bpmn:incoming>Flow_Ui_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ui_4b</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="MsgCatch_Upd_Decline" name="Decline received">
      <bpmn:incoming>Flow_Ui_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_5a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Upd_Decline_Init" messageRef="Msg_Upd_Decline" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvt_Upd_Declined" name="Declined">
      <bpmn:incoming>Flow_Ui_5a</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="MsgCatch_Upd_Declare" name="Declare received">
      <bpmn:incoming>Flow_Ui_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_5b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Upd_Declare_Init" messageRef="Msg_Upd_Declare" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_Upd_Confirm" name="Confirm Update">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Confirm_ProsumerUpdate" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ui_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Upd_Decision" name="Accept update?">
      <bpmn:incoming>Flow_Ui_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_7a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ui_7b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Upd_Accept" name="Accept Update Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;Application/json&quot;, &quot;accept&quot;: &quot;Application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&quot;name&quot;: &quot;Msg_Upd_Accept&quot;, &quot;correlationKey&quot;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ui_7a</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_8a</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Upd_Reject" name="Reject Update Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;Application/json&quot;, &quot;accept&quot;: &quot;Application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&quot;name&quot;: &quot;Msg_Upd_Reject&quot;, &quot;correlationKey&quot;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ui_7b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ui_8b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvt_Upd_Done" name="Done">
      <bpmn:incoming>Flow_Ui_8a</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvt_Upd_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Ui_8b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Ui_1" sourceRef="StartEvt_UpdInit" targetRef="Task_Upd_EnterData" />
    <bpmn:sequenceFlow id="Flow_Ui_2" sourceRef="Task_Upd_EnterData" targetRef="Task_Upd_SendReq" />
    <bpmn:sequenceFlow id="Flow_Ui_3" sourceRef="Task_Upd_SendReq" targetRef="GW_Upd_WaitResp" />
    <bpmn:sequenceFlow id="Flow_Ui_4a" sourceRef="GW_Upd_WaitResp" targetRef="MsgCatch_Upd_Decline" />
    <bpmn:sequenceFlow id="Flow_Ui_4b" sourceRef="GW_Upd_WaitResp" targetRef="MsgCatch_Upd_Declare" />
    <bpmn:sequenceFlow id="Flow_Ui_5a" sourceRef="MsgCatch_Upd_Decline" targetRef="EndEvt_Upd_Declined" />
    <bpmn:sequenceFlow id="Flow_Ui_5b" sourceRef="MsgCatch_Upd_Declare" targetRef="Task_Upd_Confirm" />
    <bpmn:sequenceFlow id="Flow_Ui_6" sourceRef="Task_Upd_Confirm" targetRef="GW_Upd_Decision" />
    <bpmn:sequenceFlow id="Flow_Ui_7a" name="Yes" sourceRef="GW_Upd_Decision" targetRef="Task_Upd_Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=accept</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ui_7b" name="No" sourceRef="GW_Upd_Decision" targetRef="Task_Upd_Reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(accept)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ui_8a" sourceRef="Task_Upd_Accept" targetRef="EndEvt_Upd_Done" />
    <bpmn:sequenceFlow id="Flow_Ui_8b" sourceRef="Task_Upd_Reject" targetRef="EndEvt_Upd_Rejected" />
  </bpmn:process>

  <!-- EXECUTOR PROCESS -->
  <bpmn:process id="ProsumerUpdateExecutor" name="ProsumerUpdateExecutor" isExecutable="true">
    <bpmn:laneSet id="LaneSet_UpdExec">
      <bpmn:lane id="Lane_UpdExec" name="Executor TK02">
        <bpmn:flowNodeRef>StartEvt_UpdExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_FetchProsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_ReviewReq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Upd_Promise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_UpdExec_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_UpdateProsumer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upd_Declare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Upd_WaitResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Upd_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MsgCatch_Upd_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_UpdExec_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvt_UpdExec_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvt_UpdExec" name="Request received">
      <bpmn:outgoing>Flow_Ue_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Upd_FetchProsumer" name="Fetch Current Prosumer Data" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&quot;http://KONG_DNS_PLACEHOLDER:8000/Prosumer/&quot; + string(prosumerId)" target="url" />
          <zeebe:input source="={&quot;accept&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="=true" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ prosumerData: response.body }" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ue_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Upd_ReviewReq" name="Review Update Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_Promise_ProsumerUpdate" />
        <zeebe:assignmentDefinition assignee="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ue_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Upd_Promise" name="Promise update?">
      <bpmn:incoming>Flow_Ue_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ue_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Upd_Decline" name="Decline Update Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;Application/json&quot;, &quot;accept&quot;: &quot;Application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&quot;name&quot;: &quot;Msg_Upd_Decline&quot;, &quot;correlationKey&quot;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ue_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_5a</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvt_UpdExec_Declined" name="Declined">
      <bpmn:incoming>Flow_Ue_5a</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Upd_UpdateProsumer" name="Update Prosumer" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="PUT" target="method" />
          <zeebe:input source="=&quot;http://KONG_DNS_PLACEHOLDER:8000/Prosumer/&quot; + string(prosumerId) + &quot;/&quot; + name + &quot;/&quot; + string(fiscalnumber) + &quot;/&quot; + location" target="url" />
          <zeebe:input source="={&quot;accept&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ue_4b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_5b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Upd_Declare" name="Declare Update Order" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://CAMUNDA_DNS_PLACEHOLDER:8080/v2/messages/publication" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;Application/json&quot;, &quot;accept&quot;: &quot;Application/json&quot;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&quot;name&quot;: &quot;Msg_Upd_Declare&quot;, &quot;correlationKey&quot;: string(prosumerId)}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ue_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:eventBasedGateway id="GW_Upd_WaitResult" name="Wait for result">
      <bpmn:incoming>Flow_Ue_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_7a</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ue_7b</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="MsgCatch_Upd_Accept" name="Accept received">
      <bpmn:incoming>Flow_Ue_7a</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_8a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Upd_Accept_Exec" messageRef="Msg_Upd_Accept" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="MsgCatch_Upd_Reject" name="Reject received">
      <bpmn:incoming>Flow_Ue_7b</bpmn:incoming>
      <bpmn:outgoing>Flow_Ue_8b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Upd_Reject_Exec" messageRef="Msg_Upd_Reject" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvt_UpdExec_Accepted" name="Accepted">
      <bpmn:incoming>Flow_Ue_8a</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvt_UpdExec_Rejected" name="Rejected">
      <bpmn:incoming>Flow_Ue_8b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Ue_1" sourceRef="StartEvt_UpdExec" targetRef="Task_Upd_FetchProsumer" />
    <bpmn:sequenceFlow id="Flow_Ue_2" sourceRef="Task_Upd_FetchProsumer" targetRef="Task_Upd_ReviewReq" />
    <bpmn:sequenceFlow id="Flow_Ue_3" sourceRef="Task_Upd_ReviewReq" targetRef="GW_Upd_Promise" />
    <bpmn:sequenceFlow id="Flow_Ue_4a" name="No" sourceRef="GW_Upd_Promise" targetRef="Task_Upd_Decline">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(promise)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ue_4b" name="Yes" sourceRef="GW_Upd_Promise" targetRef="Task_Upd_UpdateProsumer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=promise</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ue_5a" sourceRef="Task_Upd_Decline" targetRef="EndEvt_UpdExec_Declined" />
    <bpmn:sequenceFlow id="Flow_Ue_5b" sourceRef="Task_Upd_UpdateProsumer" targetRef="Task_Upd_Declare" />
    <bpmn:sequenceFlow id="Flow_Ue_6" sourceRef="Task_Upd_Declare" targetRef="GW_Upd_WaitResult" />
    <bpmn:sequenceFlow id="Flow_Ue_7a" sourceRef="GW_Upd_WaitResult" targetRef="MsgCatch_Upd_Accept" />
    <bpmn:sequenceFlow id="Flow_Ue_7b" sourceRef="GW_Upd_WaitResult" targetRef="MsgCatch_Upd_Reject" />
    <bpmn:sequenceFlow id="Flow_Ue_8a" sourceRef="MsgCatch_Upd_Accept" targetRef="EndEvt_UpdExec_Accepted" />
    <bpmn:sequenceFlow id="Flow_Ue_8b" sourceRef="MsgCatch_Upd_Reject" targetRef="EndEvt_UpdExec_Rejected" />
  </bpmn:process>

